pipeline {
    agent { label 'local-agent' }

       stages {
 stage('Build with Gradle') {
            steps {
                dir('task3-gradle-springboot') {
                    sh './gradlew build'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('task3-gradle-springboot') {
                    sh 'docker build -t task3-notes-api:latest .'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker stop task3-container || true'
                sh 'docker rm task3-container || true'
                sh 'docker run -d -p 8081:8080 --name task3-container task3-notes-api:latest'
            }
        }
    }
}
